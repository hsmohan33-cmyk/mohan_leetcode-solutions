class Solution {
    
    public int lengthOfLongestSubstring(String s) {
        int result =0,r=0,temp;
        for(int i=0;i<s.length();i++){
            String s1 = s.substring(r,i);
            if(!s1.contains(s.charAt(i)+"")){
                temp = s1.length()+1;
                result = Math.max(temp,result);
            }
            else{
                r+=s1.indexOf(s.charAt(i))+1;
            }
        }
        return result;
    }
}
