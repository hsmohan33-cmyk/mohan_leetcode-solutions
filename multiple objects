class Employee {
    int empId;
    String name;
    double salary;

    // Constructor to initialize employee details
    public Employee(int empId, String name, double salary) {
        this.empId = empId;
        this.name = name;
        this.salary = salary;
    }

    // Method to display a single employee's details
    public void displayDetails() {
        System.out.println("ID: " + empId + " | Name: " + name + " | Salary: $" + salary);
    }
}

public class MultipleObjectsDemo {
    public static void main(String[] args) {
        // Creating an array to hold multiple Employee objects
        Employee[] employees = new Employee[3];

        // Initializing individual objects and assigning them to the array
        employees[0] = new Employee(101, "Alice Smith", 75000.0);
        employees[1] = new Employee(102, "Bob Jones", 62000.5);
        employees[2] = new Employee(103, "Charlie Brown", 88000.0);

        // Displaying details of all employees using a loop
        System.out.println("----- List of All Employees -----");
        for (int i = 0; i < employees.length; i++) {
            employees[i].displayDetails();
        }
    }
}
